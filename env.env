# --- Agent System Configuration ---
# Set to "true" to enable multi-agent system, "false" to use legacy processing
USE_AGENT_SYSTEM=false

# Emergency kill switch - set to "true" to disable agent system regardless of USE_AGENT_SYSTEM
DISABLE_AGENT_SYSTEM=false

# Maximum retry attempts for agent workflows (default: 3)
MAX_AGENT_RETRIES=3

# Timeout for individual agent execution in seconds (default: 120)
AGENT_EXECUTION_TIMEOUT=120

# Timeout for StateGraph execution in seconds (default: 10)
GRAPH_EXECUTION_TIMEOUT=10